#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        mac: mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp A &kp C &kp SPACE &kp S &kp E &kp T &kp U &kp P>;
            label = "MAC";
        };

        linux: linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L &kp I &kp N &kp U &kp X &kp SPACE &kp S &kp E &kp T &kp U &kp P>;
            label = "LINUX";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        linux_0 {
            bindings = <
&kp TAB   &kp Q  &kp W  &kp E         &kp R      &kp T    &kp Y      &kp U            &kp I              &kp O    &kp P     &kp BSPC
&kp ESC   &kp A  &kp S  &kp D         &kp F      &kp G    &kp H      &kp J            &kp K              &kp L    &kp SEMI  &kp SINGLE_QUOTE
&kp LGUI  &kp Z  &kp X  &kp C         &kp V      &kp B    &kp N      &kp M            &kp COMMA          &kp DOT  &kp FSLH  &mo 2
                        &kp LEFT_ALT  &kp SPACE  &mo 1    &kp ENTER  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL
            >;
        };

        linux_1 {
            bindings = <
&kp GRAVE  &kp N1    &kp N2    &kp N3     &kp N4     &kp N5       &kp N6           &kp N7          &kp N8         &kp N9     &kp N0  &kp DEL
&kp LCTRL  &kp LBKT  &kp RBKT  &kp RBKT   &kp EQUAL  &kp MINUS    &kp LEFT         &kp DOWN        &kp UP         &kp RIGHT  &trans  &kp PRINTSCREEN
&kp LSHFT  &trans    &trans    &kp LC(C)  &kp LC(V)  &kp PIPE     &trans           &trans          &trans         &trans     &trans  &trans
                               &kp LGUI   &trans     &kp SPACE    &kp PRINTSCREEN  &kp LEFT_SHIFT  &kp RIGHT_ALT
            >;
        };

        linux_2 {
            bindings = <
&kp TAB       &kp F1   &kp F2   &kp F3    &kp F4  &kp F5       &kp F6         &kp F7        &kp F8        &kp F9        &kp F10       &kp BSPC
&kp CAPSLOCK  &kp F11  &kp F12  &trans    &trans  &trans       &kp MINUS      &kp EQUAL     &kp LBKT      &kp RBKT      &kp BSLH      &kp V
&kp LSHFT     &to 3    &linux   &trans    &trans  &trans       &kp LS(UNDER)  &kp LS(PLUS)  &kp LS(LBRC)  &kp LS(RBRC)  &kp LS(PIPE)  &kp LS(PIPE)
                                &kp LGUI  &trans  &kp SPACE    &kp ENTER      &trans        &trans
            >;
        };

        mac_0 {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB        &kp Q  &kp W  &kp E         &kp R      &kp T    &kp Y    &kp U           &kp I      &kp O    &kp P     &kp BSPC
&kp ESC        &kp A  &kp S  &kp D         &kp F      &kp G    &kp H    &kp J           &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_META  &kp Z  &kp X  &kp C         &kp V      &kp B    &kp N    &kp M           &kp COMMA  &kp DOT  &kp FSLH  &mo 5
                             &kp LEFT_ALT  &kp SPACE  &mo 4    &kp RET  &kp LEFT_SHIFT  &kp RCTRL
            >;
        };

        mac_1 {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp GRAVE       &kp N1     &kp N2            &kp N3             &kp N4     &kp N5       &kp N6                    &kp N7                     &kp N8        &kp N9     &kp N0    &kp DELETE
&kp LEFT_SHIFT  &kp LCTRL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp EQUAL  &kp MINUS    &kp LEFT                  &kp DOWN                   &kp UP        &kp RIGHT  &kp HOME  &kp GRAVE
&kp F2          &kp Z      &kp F12           &kp LG(C)          &kp LG(V)  &kp PIPE     &kp LS(LEFT_PARENTHESIS)  &kp LS(RIGHT_PARENTHESIS)  &kp CAPSLOCK  &kp PLUS   &mo 0     &kp PRINTSCREEN
                                             &kp LGUI           &trans     &none        &kp PRINTSCREEN           &kp RIGHT_SHIFT            &kp RALT
            >;
        };

        mac_3 {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp F1   &kp F2   &kp F3         &kp F4        &kp F5          &kp F6     &kp F7     &kp F8    &kp F9    &kp F10   &kp BSPC
&kp LCTRL  &kp F11  &kp F12  &kp PAGE_DOWN  &kp PAGE_UP   &trans          &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &to 0    &mac     &trans         &bt BT_SEL 1  &bt BT_SEL 0    &kp UNDER  &kp PLUS   &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE
                             &kp LEFT_ALT   &trans        &kp SPACE       &kp RET    &trans     &kp RALT
            >;
        };
    };
};
